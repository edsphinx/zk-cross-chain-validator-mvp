# Private key for deploying contracts and submitting transactions
# WARNING: Never commit your actual private key to git!
PRIVATE_KEY=your_private_key_here

# RPC URL for the blockchain network
# Examples:
# - Scroll Sepolia: https://sepolia-rpc.scroll.io/
# - Scroll Mainnet: https://rpc.scroll.io/
# - Local: http://127.0.0.1:8545
RPC_URL=https://sepolia-rpc.scroll.io/

# Deployed contract addresses (fill these after deployment)
VERIFIER_ADDRESS=
CONTRACT_ADDRESS=

# Etherscan API key for contract verification (optional)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Network configuration
CHAIN_ID=534351  # Scroll Sepolia testnet
